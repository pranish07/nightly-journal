# Nightly Journal environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every variable below is optional except where noted; the defaults are safe for local development.

# --- Core ---
APP_ENV=development
DATABASE_URL=sqlite:///./nightly-journal.db
PUBLIC_BASE_URL=http://localhost:8000

# Generate independent secrets for each value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production rejects empty values, the development defaults, or values shorter than 32 characters.
# FORM_TOKEN_SECRET=
# CSRF_SECRET=
# CRON_SECRET=

STREAK_MIN_COMPLETION=1.0
FORM_TOKEN_MAX_AGE_SECONDS=172800
CSRF_MAX_AGE_SECONDS=172800
LOG_LEVEL=INFO
# TRUST_PROXY_HEADERS=true

# --- Email ---
# smtp (default) or resend
MAIL_TRANSPORT=smtp
EMAIL_FROM=Nightly Journal <journal@example.com>
EMAIL_TO=you@example.com

# Brevo SMTP on port 2525 (Render blocks 25, 465, and 587).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# Resend HTTPS alternative. Set MAIL_TRANSPORT=resend to use it.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_SECONDS=20

# Optional Gmail IMAP check for `python -m app.cli send-test-email`.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- Gemini (optional) ---
# Leave the key or model empty to use the deterministic rule-based fallback.
# Example model: gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=20
